{
  "manifest_version": 3,
  "name": "RefWare Capture",
  "version": "1.0",
  "key": "",
  "description": "Send the current page, PDF, or a linked item to your RefWare library (UEF).",
  "permissions": [
    "contextMenus",
    "activeTab",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Add this tab to RefWare",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Add this tab to RefWare"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}